<%- include ../partials/header %> 
<%- include ../partials/categories-navbar %>

<%
  function getCategorySlug(product) {
    return product && product.category && product.category.slug
      ? product.category.slug
      : '#';
  }
%>

<!-- Top Carousel -->
<div id="topCarousel" class="carousel slide mb-3 mt-0 pt-0" data-ride="carousel">
  <ol class="carousel-indicators">
    <li data-target="#topCarousel" data-slide-to="0" class="active"></li>
    <li data-target="#topCarousel" data-slide-to="1"></li>
    <li data-target="#topCarousel" data-slide-to="2"></li>
  </ol>

  <div class="carousel-inner">
    <div class="carousel-item active">
      <img class="d-block w-100" src="/images/slide1.jpg" />
    </div>
    <div class="carousel-item">
      <img class="d-block w-100" src="/images/slide2.jpg" />
    </div>
    <div class="carousel-item">
      <img class="d-block w-100" src="/images/slide3.jpg" />
    </div>
  </div>
</div>

<!-- Categories -->
<div class="container">
  <h3 class="text-center mb-3 mt-4">Store's Categories</h3>
  <div class="row">

    <% if (Array.isArray(categories) && categories.length > 0) { %>
      <% for(let i = 0; i < Math.min(10, categories.length); i++) { %>
        <div class="col-lg-3 col-md-4 col-sm-6 text-center">
          <a class="title-link" href="/products/<%= categories[i].slug || '#' %>">
            <img src="images/dept<%=i%>.jpg" class="circle-img" />
            <h4><%= categories[i].title || ('Category ' + (i+1)) %></h4>
          </a>
        </div>
      <% } %>
    <% } %>

  </div>
</div>

<hr />

<!-- Products -->
<div class="container mt-4">

  <div id="products-carousel" class="carousel slide carousel-multi-item" data-ride="carousel">
    <div class="controls-top mb-2" style="text-align: center;">
      <div class="row" >
        <div class="col-8" >
          <h3>Latest Products</h3>
        </div>
        <div class="col-4">
          <div class="controls float-right hidden-xs">
            <a class="left fa fa-chevron-left btn btn" href="#products-carousel" data-slide="prev"></a>
            <a class="right fa fa-chevron-right btn" href="#products-carousel" data-slide="next"></a>
          </div>
        </div>
      </div>
    </div>
    <div class="carousel-inner">

      <!-- SLIDE 1 -->
      <div class="carousel-item active">
        <div class="row">
          <% for(let i = 0; i < Math.min(3, products.length); i++) { %>

            <div class="col-md-4">
              <a href="/products/<%= getCategorySlug(products[i]) %>/<%= products[i]._id %>">
                <img src="<%= products[i].imagePath %>" class="img-fluid"/>
              </a>

              <h6><%= products[i].title %></h6>
              <div>Rs.<%= products[i].price %></div>

              <% if(products[i].available) { %>
                <a href="/add-to-cart/<%=products[i]._id%>" class="btn btn-secondary">
                  Add to Cart
                </a>
              <% } else { %>
                <button class="btn btn-danger">Sold Out</button>
              <% } %>
            </div>

          <% } %>
        </div>
      </div>

      <!-- SLIDE 2 -->
      <div class="carousel-item">
        <div class="row">
          <% for(let i = 3; i < Math.min(6, products.length); i++) { %>

            <div class="col-md-4">
              <a href="/products/<%= getCategorySlug(products[i]) %>/<%= products[i]._id %>">
                <img src="<%= products[i].imagePath %>" class="img-fluid"/>
              </a>

              <h6><%= products[i].title %></h6>
              <div>Rs.<%= products[i].price %></div>

              <% if(products[i].available) { %>
                <a href="/add-to-cart/<%=products[i]._id%>" class="btn btn-secondary">
                  Add to Cart
                </a>
              <% } else { %>
                <button class="btn btn-danger">Sold Out</button>
              <% } %>
            </div>

          <% } %>
        </div>
      </div>

      <!-- SLIDE 3 -->
      <div class="carousel-item">
        <div class="row">
          <% for(let i = 6; i < Math.min(9, products.length); i++) { %>

            <div class="col-md-4">
              <a href="/products/<%= getCategorySlug(products[i]) %>/<%= products[i]._id %>">
                <img src="<%= products[i].imagePath %>" class="img-fluid"/>
              </a>

              <h6><%= products[i].title %></h6>
              <div>Rs.<%= products[i].price %></div>

              <% if(products[i].available) { %>
                <a href="/add-to-cart/<%=products[i]._id%>" class="btn btn-secondary">
                  Add to Cart
                </a>
              <% } else { %>
                <button class="btn btn-danger">Sold Out</button>
              <% } %>
            </div>

          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include ../partials/footer %>